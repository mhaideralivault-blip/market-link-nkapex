MONGO_URI=your_mongodb_atlas_connection_string
PORT=5000
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d
# Comma-separated allowed frontend origins (omit to allow all in dev)
CLIENT_URL=http://localhost:5173
# Dedicated database name for this app
MONGO_DB_NAME=marketlink
# Set this in Vercel's project env vars; Vercel Cron then sends it automatically as
# `Authorization: Bearer $CRON_SECRET` when it calls /api/cron/apply-weekly-templates
CRON_SECRET=
